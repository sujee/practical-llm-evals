# Copy this file to .env and set the values. The scripts load .env automatically.

# no /v1 at the end of url
BASE_URL=https://api.tokenfactory.nebius.com

API_KEY=your_api_key_here

MODEL=Qwen/Qwen3.8-27B

# HuggingFace tokenizer that builds prompts of exact length. Use the tokenizer of the model if you can.
TOKENIZER=Qwen/Qwen3.8-27B
